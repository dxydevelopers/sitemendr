# Database Configuration
DATABASE_URL="postgresql://username:password@hostname:port/database?pgbouncer=true&sslmode=require&connection_limit=20&pool_timeout=30"
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=YourAppName

PORT=5000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# Social sign-in (buttons only become active when required credentials and callbacks are configured)
# Set API_PUBLIC_URL to the public API origin in production, e.g. https://api.example.com.
# Register these callback URLs with each provider:
#   /api/auth/oauth/google/callback
#   /api/auth/oauth/github/callback
#   /api/auth/oauth/apple/callback
API_PUBLIC_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Store the Apple .p8 private key with newline characters escaped.
APPLE_REDIRECT_URI=

# My Account phone verification: SMS uses Twilio Verify; WhatsApp uses an inbound-only Meta webhook.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Required for SMS only.
TWILIO_VERIFY_SERVICE_SID=
# Required for WhatsApp. Use digits only with country code, for example 2547XXXXXXXX.
WHATSAPP_BUSINESS_NUMBER=
# Meta WhatsApp Cloud API webhook configuration. The callback URL is:
#   https://<your-backend-host>/api/auth/whatsapp/webhook
# Subscribe the Meta app to the WhatsApp "messages" webhook field.
META_WHATSAPP_PHONE_NUMBER_ID=
META_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Groq Configuration (Fallback)
GROQ_API_KEY=your_groq_api_key_here

# Required for real Lighthouse performance scans via Google PageSpeed Insights
PAGESPEED_API_KEY=your_pagespeed_api_key_here

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Email Configuration
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here
ADMIN_EMAIL=admin@sitemendr.com
EMAIL_TRANSPORT=log
EMAIL_FROM="Sitemendr <no-reply@sitemendr.com>"
RESEND_API_KEY=your_resend_api_key_here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
EMAIL_VERIFY_ON_START=true
EMAIL_ALLOW_INSECURE=false

# Domains
MAIN_DOMAIN=sitemendr.com
API_DOMAIN=api.sitemendr.com

# Paystack Configuration
PAYSTACK_PUBLIC_KEY=your_paystack_public_key
PAYSTACK_SECRET_KEY=your_paystack_secret_key
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret
PAYSTACK_CURRENCY=NGN

# Infrastructure & Automation
DISABLE_AUTOMATION=false
SSL_ENABLED=true
CLOUDFLARE_API_TOKEN=your_cloudflare_token_for_dns_automation
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id
# Set the real public origin IP before enabling custom-domain connections.
# Clients point both @ and www A records to this address.
INFRA_IP=

# Deployment Providers
VERCEL_TOKEN=your_vercel_token
VERCEL_TEAM_ID=your_vercel_team_id
NETLIFY_TOKEN=your_netlify_token
NETLIFY_SITE_ID=your_netlify_site_id
DEPLOYMENT_PROVIDER=local # or vercel, netlify

# Security
BCRYPT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=5242880  # 5MB
UPLOAD_PATH=./uploads

# Analytics
GOOGLE_ANALYTICS_ID=your_ga_tracking_id_here



