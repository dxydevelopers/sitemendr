generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                      String           @id @default(uuid())
  name                    String
  email                   String           @unique
  password                String
  phone                   String?
  role                    Role             @default(user)
  isEmailVerified         Boolean          @default(false)
  emailVerificationToken  String?
  emailVerificationExpires DateTime?
  passwordResetToken      String?
  passwordResetExpires    DateTime?
  banned                  Boolean          @default(false)
  lastLogin               DateTime?
  country                 String           @default("US")
  defaultCurrency         String           @default("USD")
  accountType             String           @default("individual")
  billingRegion           String?
  subdomainsClaimed       Int              @default(0)
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  blogPosts               BlogPost[]
  payments                Payment[]
  leadsAssigned           Lead[]           @relation("AssignedTo")
  leadsOwned              Lead[]           @relation("Owner")
  customDomains           CustomDomain[]
  subscriptions           Subscription[]
  comments                Comment[]
  messages                Message[]
  supportTickets          SupportTicket[]
  supportMessages         SupportMessage[]
  media                   Media[]
  orders                  Order[]
  bookings                Booking[]
  supporters              Supporter[]
  assessments             Assessment[]
  projectRequests         ProjectRequest[]

  @@index([role])
}

enum Role {
  user
  admin
  manager
  client
}

model Assessment {
  id                   String           @id @default(uuid())
  userId               String?
  user                 User?            @relation(fields: [userId], references: [id])
  sessionId            String           @unique
  status               AssessmentStatus @default(in_progress)
  source               Source           @default(direct)
  referrer             String?
  responses            Json
  results              Json?
  processingStartedAt  DateTime?
  processingCompletedAt DateTime?
  processingError      String?
  convertedToLead      Boolean          @default(false)
  leadId               String?
  lead                 Lead?            @relation(fields: [leadId], references: [id])
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  expiresAt            DateTime
  projectRequest       ProjectRequest?

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

enum AssessmentStatus {
  in_progress
  processing
  completed
  failed
}

enum Source {
  homepage
  email
  social
  referral
  direct
  assessment
  contact_form
  newsletter
  paid_ad
}

model Lead {
  id               String         @id @default(uuid())
  source           Source
  sourceDetails    Json?
  name             String
  email            String         @unique
  phone            String?
  company          Json?
  qualification    Json?
  communications   Json?
  status           String         @default("new")
  notes            String?
  assignedToId     String?
  assignedTo       User?          @relation("AssignedTo", fields: [assignedToId], references: [id])
  ownerId          String?
  owner            User?          @relation("Owner", fields: [ownerId], references: [id])
  consent          Json?
  converted        Boolean        @default(false)
  convertedAt      DateTime?
  convertedTo      Json?
  nextFollowUp     DateTime?
  followUpNotes    String?
  tags             String[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  lastActivity     DateTime       @default(now())
  assessments      Assessment[]

  @@index([status, createdAt])
  @@index([createdAt])
}

model BlogPost {
  id             String      @id @default(uuid())
  title          String
  slug           String      @unique
  excerpt        String?
  content        String
  featuredImage  String?
  authorId       String
  author         User        @relation(fields: [authorId], references: [id])
  category       String?
  tags           String[]
  status         PostStatus  @default(draft)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  seoKeywords    String[]
  readingTime    Int         @default(0)
  views          Int         @default(0)
  likes          Int         @default(0)
  comments       Comment[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

enum PostStatus {
  draft
  published
  archived
}

model Comment {
  id         String   @id @default(uuid())
  blogPostId String
  blogPost   BlogPost @relation(fields: [blogPostId], references: [id])
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  content    String
  status     String   @default("approved")
  createdAt  DateTime @default(now())
}

model CustomDomain {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  domain    String
  siteId    String
  subscription Subscription @relation(fields: [siteId], references: [id])
  setup     String
  status    String       @default("pending")
  sslEnabled Boolean      @default(false)
  sslExpiresAt DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model ManagedDomainRequest {
  id             String   @id @default(uuid())
  email          String   @unique
  domainInterest String
  createdAt      DateTime @default(now())
}

model Payment {
  id              String      @id @default(uuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  reference       String      @unique
  amount          Float
  currency        String      @default("USD")
  status          String      @default("pending")
  paymentMethod   String      @default("card")
  gateway         String      @default("paystack")
  gatewayResponse Json?
  metadata        Json?
  serviceType     String
  description     String
  invoiceId       String?
  supporterId     String?
  supporter       Supporter?  @relation(fields: [supporterId], references: [id])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model Subscription {
  id                  String         @id @default(uuid())
  userId              String
  user                User           @relation(fields: [userId], references: [id])
  siteName            String?
  customName          String?
  price               Float?
  planType            String         @default("monthly")
  domain              String?
  totalPaid           Float          @default(0)
  credit              Float          @default(0)
  lastPaymentDate     DateTime?
  expiresAt           DateTime?
  status              String         @default("active")
  tier                String         @default("ai_foundation")
  gracePeriodDays     Int            @default(7)
  suspendedAt         DateTime?
  reactivationAttempts Int           @default(0)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @default(now()) @updatedAt
  suspended       Boolean        @default(false)
  reviewRequested Boolean        @default(false)
  reviewNotes     String?
  revisionCount   Int            @default(0)
  performanceData Json?
  purchasedAddons Json?
  customDomains   CustomDomain[]
  milestones      Milestone[]
  template        Template?
  products        Product[]
  services        Service[]
  orders          Order[]
  bookings        Booking[]
  supportTickets  SupportTicket[]
  pages          Page[]
  themeSettings  ThemeSettings?
  projectRequests ProjectRequest[]

  @@index([userId, status, createdAt])
  @@index([status, createdAt])
}

model ProjectRequest {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  assessmentId    String?       @unique
  assessment      Assessment?   @relation(fields: [assessmentId], references: [id])
  subscriptionId  String?
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id])
  title           String
  businessName    String?
  serviceType     String        @default("build")
  packageIntent   String?
  budget          String?
  timeline        String?
  summary         String?
  status          String        @default("submitted")
  priority        String        @default("normal")
  quotedAmount    Float?
  quoteCurrency   String        @default("USD")
  paymentAgreementType   String?
  paymentAgreementStatus String  @default("pending")
  depositAmount          Float?
  totalAgreedAmount      Float?
  paymentDueDate         DateTime?
  paymentInstructions    String?
  paymentConfirmedAt     DateTime?
  productionMode         String   @default("hybrid")
  productionSourceNote   String?
  stagingUrl             String?
  stagingNotes           String?
  stagingReviewStatus    String  @default("not_sent")
  stagingReviewedAt      DateTime?
  launchUrl              String?
  launchNotes            String?
  launchApprovedAt       DateTime?
  handoffNotes           String?
  completionNotes        String?
  completionAcknowledgedAt DateTime?
  finalPaymentConfirmedAt  DateTime?
  handoffIssuesReportedAt   DateTime?
  adminNotes      String?
  clientNotes     String?
  buildMilestones BuildMilestone[]
  studioTasks     StudioTask[]
  studioLinks     StudioLink[]
  studioBlockers  StudioBlocker[]
  studioUpdates   StudioUpdate[]
  reviewMessages  ReviewChatMessage[]
  handoffMessages HandoffChatMessage[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  reviewedAt      DateTime?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  completedAt     DateTime?

  @@index([serviceType, status, updatedAt])
  @@index([userId, updatedAt])
}

model ReviewChatMessage {
  id               String         @id @default(uuid())
  projectRequestId String
  projectRequest   ProjectRequest @relation(fields: [projectRequestId], references: [id], onDelete: Cascade)
  senderId         String?
  senderRole       String         @default("client")
  message          String
  kind             String         @default("message")
  choices          Json?
  selectedChoice   String?
  attachments      Json?
  readByAdmin      Boolean        @default(false)
  readByClient     Boolean        @default(false)
  createdAt        DateTime       @default(now())

  @@index([projectRequestId, createdAt])
  @@index([projectRequestId, senderRole, readByAdmin, readByClient])
}

model HandoffChatMessage {
  id               String         @id @default(uuid())
  projectRequestId String
  projectRequest   ProjectRequest @relation(fields: [projectRequestId], references: [id], onDelete: Cascade)
  senderId         String?
  senderRole       String         @default("client")
  message          String
  kind             String         @default("message")
  choices          Json?
  selectedChoice   String?
  attachments      Json?
  readByAdmin      Boolean        @default(false)
  readByClient     Boolean        @default(false)
  createdAt        DateTime       @default(now())

  @@index([projectRequestId, createdAt])
  @@index([projectRequestId, senderRole, readByAdmin, readByClient])
}

model StudioTask {
  id               String         @id @default(uuid())
  projectRequestId String
  projectRequest   ProjectRequest @relation(fields: [projectRequestId], references: [id], onDelete: Cascade)
  title            String
  area             String         @default("build")
  status           String         @default("open")
  owner            String?
  dueDate          DateTime?
  note             String?
  order            Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([projectRequestId, area, status])
}

model StudioLink {
  id               String         @id @default(uuid())
  projectRequestId String
  projectRequest   ProjectRequest @relation(fields: [projectRequestId], references: [id], onDelete: Cascade)
  label            String
  url              String?
  type             String         @default("link")
  note             String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([projectRequestId, type])
}

model StudioBlocker {
  id               String         @id @default(uuid())
  projectRequestId String
  projectRequest   ProjectRequest @relation(fields: [projectRequestId], references: [id], onDelete: Cascade)
  title            String
  area             String         @default("general")
  status           String         @default("open")
  note             String?
  createdAt        DateTime       @default(now())
  resolvedAt       DateTime?
  updatedAt        DateTime       @updatedAt

  @@index([projectRequestId, status])
}

model StudioUpdate {
  id               String         @id @default(uuid())
  projectRequestId String
  projectRequest   ProjectRequest @relation(fields: [projectRequestId], references: [id], onDelete: Cascade)
  message          String
  visibility       String         @default("client")
  createdBy        String?
  createdAt        DateTime       @default(now())

  @@index([projectRequestId, visibility, createdAt])
}

model BuildMilestone {
  id               String         @id @default(uuid())
  projectRequestId String
  projectRequest   ProjectRequest @relation(fields: [projectRequestId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  status           String         @default("pending")
  progress         Int            @default(0)
  order            Int            @default(0)
  dueDate          DateTime?
  clientNote       String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([projectRequestId])
}

model Milestone {
  id             String       @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  title          String
  description    String?
  status         String       @default("pending")
  progress       Int          @default(0)
  order          Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NotificationRule {
  id                 String   @id @default(uuid())
  slug               String   @unique
  name               String
  category           String
  trigger            String
  recipientType      String   @default("user")
  recipientOverride  String?
  senderName         String?
  senderEmail        String?
  replyTo            String?
  subject            String   @default("")
  htmlTemplate       String   @default("") @db.Text
  availableVariables String[] @default([])
  channels           String[] @default(["email"])
  status             String   @default("active")
  sourceFile         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([category, status])
}

model Message {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  subject   String
  content   String
  isRead    Boolean  @default(false)
  sender    String   @default("System")
  createdAt DateTime @default(now())
}

model SupportTicket {
  id             String           @id @default(uuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id])
  subscriptionId String?
  subscription   Subscription?    @relation(fields: [subscriptionId], references: [id])
  subject        String
  message        String
  status         String           @default("open")
  priority       String           @default("medium")
  messages       SupportMessage[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model SupportMessage {
  id        String        @id @default(uuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id])
  senderId  String?
  sender    User?         @relation(fields: [senderId], references: [id])
  content   String
  isAdmin   Boolean       @default(false)
  isRead    Boolean       @default(false)
  createdAt DateTime      @default(now())
}

model Template {
  id             String       @id @default(uuid())
  subscriptionId String       @unique
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  html           String
  css            String?
  js             String?
  assets         Json?
  aiModel        String       @default("gpt-4o")
  isPublished    Boolean      @default(false)
  publishedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// ===========================================
// VISUAL EDITOR MODELS (Shopify-like)
// ===========================================

enum PageType {
  HOME
  PRODUCT
  COLLECTION
  BLOG
  CART
  CUSTOM
}

model Page {
  id             String     @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  type           PageType   @default(CUSTOM)
  slug           String
  title          String
  isPublished    Boolean    @default(false)
  isHome         Boolean    @default(false)
  sections       PageSection[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([subscriptionId, slug])
}

model PageSection {
  id          String           @id @default(uuid())
  pageId      String
  page        Page             @relation(fields: [pageId], references: [id], onDelete: Cascade)
  sectionId   String
  section     SectionTemplate  @relation(fields: [sectionId], references: [id])
  order       Int
  settings    Json?

  @@unique([pageId, order])
}

model SectionTemplate {
  id              String   @id @default(uuid())
  name            String
  category        String
  icon            String?
  description     String?
  defaultSettings Json
  schema          Json
  componentName  String
  isBuiltIn       Boolean  @default(true)
  isActive        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  pageSections    PageSection[]
}

model ThemeSettings {
  id               String   @id @default(uuid())
  subscriptionId   String   @unique
  subscription     Subscription @relation(fields: [subscriptionId], references: [id])

  primaryColor     String   @default("#3B82F6")
  secondaryColor   String   @default("#1E293B")
  accentColor     String   @default("#10B981")
  backgroundColor  String   @default("#FFFFFF")
  textColor       String   @default("#1F2937")

  headingFont      String   @default("Inter")
  bodyFont         String   @default("Inter")

  borderRadius    String   @default("8px")
  containerWidth  String   @default("1280px")

  buttonStyle     String   @default("rounded")
  buttonSize      String   @default("medium")

  customCss       String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Resource {
  id          String   @id @default(uuid())
  title       String
  description String
  type        String
  url         String?
  content     String?
  createdAt   DateTime @default(now())
}

model Media {
  id        String   @id @default(uuid())
  filename  String
  url       String
  mimetype  String
  size      Int
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model ChatSession {
  id        String        @id @default(uuid())
  externalId String       @unique
  type      String        @default("technical")
  status    String        @default("waiting")
  userId    String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]

  @@index([status, updatedAt])
}

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id])
  text      String
  sender    String
  timestamp DateTime    @default(now())

  @@index([sessionId, timestamp])
}

model Product {
  id             String       @id @default(uuid())
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  name           String
  description    String
  price          Float
  image          String?
  category       String?
  stock          Int          @default(0)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  orderItems     OrderItem[]
}

model Order {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  status         String       @default("pending")
  totalAmount    Float
  discountCodeId String?
  discountCode   DiscountCode? @relation(fields: [discountCodeId], references: [id])
  items          OrderItem[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}

model Service {
  id             String       @id @default(uuid())
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  name           String
  description    String
  duration       Int
  price          Float
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  bookings       Booking[]
}

model Booking {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  serviceId      String
  service        Service      @relation(fields: [serviceId], references: [id])
  startTime      DateTime
  endTime        DateTime
  status         String       @default("confirmed")
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// =============================================================================
// Supporter Models
// =============================================================================

model SupporterTier {
  id                String          @id @default(uuid())
  name              String
  slug              String          @unique
  description       String?
  monthlyPrice      Float
  yearlyPrice       Float?
  discountPercent   Int
  displayOrder      Int             @default(0)
  isActive          Boolean         @default(true)

  perks             String[]

  supporters        Supporter[]
  discountCodes     DiscountCode[]

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model Supporter {
  id                String          @id @default(uuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id])
  tierId            String
  tier              SupporterTier   @relation(fields: [tierId], references: [id])

  status            SupporterStatus @default(active)
  reference         String          @unique

  monthlyAmount     Float
  currency          String          @default("USD")
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  lastPaymentDate   DateTime?
  cancelAtPeriodEnd Boolean         @default(false)

  showOnWall        Boolean         @default(true)
  spotlightTier     Int             @default(0)

  discountCodes     DiscountCode[]
  redeemedPerks     RedeemedPerk[]
  payments          Payment[]
  spotlights        SupporterSpotlight[]
  eventRegistrations EventRegistration[]
  votes             VoteChoice[]

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

enum SupporterStatus {
  active
  paused
  cancelled
  expired
}

model DiscountCode {
  id                String          @id @default(uuid())
  code              String          @unique

  supporterId       String?
  supporter         Supporter?      @relation(fields: [supporterId], references: [id])
  tierId            String?
  tier              SupporterTier?  @relation(fields: [tierId], references: [id])

  discountType      DiscountType    @default(percentage)
  discountValue     Float
  minPurchaseAmount Float?
  maxUses           Int?
  currentUses       Int             @default(0)

  isActive          Boolean         @default(true)
  validFrom         DateTime        @default(now())
  expiresAt         DateTime?

  orders            Order[]

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

enum DiscountType {
  percentage
  fixed
}

model Perk {
  id                String          @id @default(uuid())
  name              String
  slug              String          @unique
  description       String?
  icon              String?
  tierRequired      String[]

  isRedeemable      Boolean         @default(true)
  maxRedemptions    Int?

  redemptionUrl     String?
  redemptionCode    String?

  redeemedPerks     RedeemedPerk[]

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model RedeemedPerk {
  id                String          @id @default(uuid())
  supporterId       String
  supporter         Supporter       @relation(fields: [supporterId], references: [id])
  perkId            String
  perk              Perk            @relation(fields: [perkId], references: [id])

  redeemedAt        DateTime        @default(now())
  redemptionCode    String?

  @@unique([supporterId, perkId])
}

model SupporterSpotlight {
  id                String          @id @default(uuid())
  supporterId       String
  supporter         Supporter       @relation(fields: [supporterId], references: [id])

  message           String?
  displayName       String?
  tierLevel         Int

  isActive          Boolean         @default(true)
  displayOrder      Int             @default(0)

  createdAt         DateTime        @default(now())
}

model CommunityEvent {
  id                String          @id @default(uuid())
  title              String
  slug              String          @unique
  description       String
  eventType         EventType

  scheduledAt       DateTime
  durationMinutes   Int             @default(60)
  timezone          String          @default("UTC")

  tierRequired      String[]
  maxParticipants   Int?
  currentParticipants Int           @default(0)

  meetingLink       String?
  recordingUrl      String?

  status            EventStatus     @default(scheduled)

  registrations     EventRegistration[]

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

enum EventType {
  roundtable
  ama
  poll
}

enum EventStatus {
  scheduled
  live
  completed
  cancelled
}

model EventRegistration {
  id                String          @id @default(uuid())
  eventId           String
  event             CommunityEvent  @relation(fields: [eventId], references: [id])
  supporterId       String
  supporter         Supporter       @relation(fields: [supporterId], references: [id])

  status            String          @default("registered")

  registeredAt      DateTime        @default(now())

  @@unique([eventId, supporterId])
}

model ProductVote {
  id                String          @id @default(uuid())
  title             String
  description       String
  options           String[]

  tierRequired      String[]

  startsAt          DateTime
  endsAt            DateTime

  status            VoteStatus      @default(draft)

  votes             VoteChoice[]

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

enum VoteStatus {
  draft
  active
  closed
  results
}

model VoteChoice {
  id                String          @id @default(uuid())
  voteId            String
  vote              ProductVote     @relation(fields: [voteId], references: [id])
  supporterId       String
  supporter         Supporter       @relation(fields: [supporterId], references: [id])

  optionIndex       Int

  votedAt           DateTime        @default(now())

  @@unique([voteId, supporterId])
}

// =============================================================================
// Portfolio Models — added for the public /portfolio pages
// =============================================================================

enum ProjectCategory {
  BUSINESS
  WORKSPACE
  COMMERCE
  REPAIR
}

model Project {
  id            String          @id @default(uuid())
  title         String
  slug          String          @unique
  category      ProjectCategory
  summary       String
  problem       String          @db.Text
  decision      String          @db.Text
  result        String          @db.Text
  liveUrl       String?
  featured      Boolean         @default(false)
  published     Boolean         @default(false)
  displayOrder  Int             @default(0)
  images        ProjectImage[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([published, category])
}

model ProjectImage {
  id            String   @id @default(uuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url           String
  description   String   @db.Text
  displayOrder  Int      @default(0)

  @@index([projectId])
}
